# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
# Allowed CORS Origins (comma-separated for multiple, e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Supabase Transaction Pooler, Port 6543)
# For Serverless (Vercel): Set DATABASE_POOL_MIN=0 to prevent holding idle connections
DATABASE_URL=postgresql://postgres.fodeqiisxhufnuyldpcn:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
DATABASE_SSL=true

# Backend-Owned Authentication & Security (Must be high-entropy secrets in production)
JWT_ACCESS_SECRET=deluzex_dev_super_secret_access_key_change_in_prod_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=deluzex_dev_super_secret_refresh_key_change_in_prod_2026
JWT_REFRESH_EXPIRES_IN=7d

# Throttler / Rate Limiting (Optional)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

